+package com.android.systemui.leo;
+
+import android.content.Context;
+import android.os.Bundle;
+import android.os.SystemClock;
+import android.widget.Button;
+import android.widget.LinearLayout;
+import android.widget.SeekBar;
+import android.widget.TextView;
+import com.android.systemui.R;
+import com.android.systemui.statusbar.phone.SystemUIDialog;
+
+/** Explicit DAC-volume apply. No write on open, drag, close, reconnect or boot. */
+public final class LeoHifiVolumeDialog extends SystemUIDialog implements LeoHifiController.Callback {
+    private final LeoHifiController controller;
+    private SeekBar slider;
+    private Button apply;
+    private TextView readback, status;
+    private boolean touched;
+    public LeoHifiVolumeDialog(Context context, LeoHifiController controller) {
+        super(context); this.controller = controller;
+    }
+    @Override protected void onCreate(Bundle savedInstanceState) {
+        setTitle(R.string.leo_hifi_volume_title);
+        LinearLayout layout = new LinearLayout(getContext());
+        layout.setOrientation(LinearLayout.VERTICAL);
+        int padding = (int)(24 * getContext().getResources().getDisplayMetrics().density + 0.5f);
+        layout.setPadding(padding, padding, padding, padding);
+        TextView warning = new TextView(getContext());
+        warning.setText(R.string.leo_hifi_volume_warning); layout.addView(warning);
+        status = new TextView(getContext()); layout.addView(status);
+        readback = new TextView(getContext()); layout.addView(readback);
+        slider = new SeekBar(getContext()); slider.setMax(60);
+        slider.setContentDescription(getContext().getString(R.string.leo_hifi_volume_title));
+        slider.setProgress(controller.getState().volumeUser); layout.addView(slider);
+        apply = new Button(getContext()); apply.setText(R.string.leo_hifi_apply); layout.addView(apply);
+        setView(layout); setNegativeButton(android.R.string.cancel, (dialog, which) -> dismiss());
+        super.onCreate(savedInstanceState);
+        slider.setOnSeekBarChangeListener(new SeekBar.OnSeekBarChangeListener() {
+            public void onProgressChanged(SeekBar bar, int progress, boolean fromUser) {
+                if (fromUser) { touched = true; onStateChanged(controller.getState()); }
+            }
+            public void onStartTrackingTouch(SeekBar bar) {}
+            public void onStopTrackingTouch(SeekBar bar) {}
+        });
+        apply.setOnClickListener(view -> {
+            LeoHifiState s = controller.getState();
+            if (touched && s.active && !s.pending && s.isFresh(SystemClock.elapsedRealtime())) {
+                touched = false; apply.setEnabled(false);
+                controller.requestVolume(slider.getProgress()); // zero is valid, NOT mute
+            }
+        });
+        controller.addCallback(this);
+        setOnDismissListener(dialog -> controller.removeCallback(this));
+        onStateChanged(controller.getState());
+    }
+    @Override public void onStateChanged(LeoHifiState s) {
+        if (slider == null) return;
+        boolean ready = s.available && s.supported && s.active && !s.pending
+                && s.isFresh(SystemClock.elapsedRealtime());
+        slider.setEnabled(ready); apply.setEnabled(ready && touched);
+        status.setText(s.pending ? R.string.leo_hifi_waiting
+                : "request_failed".equals(s.reason) || "request_rejected".equals(s.reason)
+                ? R.string.leo_hifi_error : ready ? R.string.leo_hifi_active : R.string.leo_hifi_not_active);
+        readback.setText(getContext().getString(R.string.leo_hifi_volume_readback,
+                slider.getProgress(), s.volumeLeft, s.volumeRight));
+    }
+}
