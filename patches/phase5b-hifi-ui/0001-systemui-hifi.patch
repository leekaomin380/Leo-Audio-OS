+++ b/packages/SystemUI/src/com/android/systemui/qs/tiles/LeoHifiTile.java
@@ -0,0 +1,135 @@
+package com.android.systemui.qs.tiles;
+
+import android.content.Intent;
+import android.widget.Switch;
+import com.android.internal.logging.nano.MetricsProto.MetricsEvent;
+import android.os.Build;
+import android.os.SystemClock;
+import android.service.quicksettings.Tile;
+import com.android.systemui.Dependency;
+import com.android.systemui.R;
+import com.android.systemui.plugins.ActivityStarter;
+import com.android.systemui.plugins.qs.QSTile.BooleanState;
+import com.android.systemui.qs.QSHost;
+import com.android.systemui.qs.tileimpl.QSTileImpl;
+import com.android.systemui.leo.LeoHifiController;
+import com.android.systemui.leo.LeoHifiState;
+import com.android.systemui.leo.LeoHifiVolumeDialog;
+
+public class LeoHifiTile extends QSTileImpl<BooleanState> implements LeoHifiController.Callback {
+
+    private final Icon mIcon = ResourceIcon.get(R.drawable.ic_leo_hifi);
+    private final LeoHifiController mController;
+
+    public LeoHifiTile(QSHost host) {
+        super(host);
+        mController = LeoHifiController.get(mContext);
+        mController.addCallback(this);
+    }
+
+    @Override
+    protected void handleDestroy() {
+        super.handleDestroy();
+        mController.removeCallback(this);
+    }
+
+    @Override
+    public BooleanState newTileState() {
+        return new BooleanState();
+    }
+
+    @Override
+    protected void handleSetListening(boolean listening) {
+        if (listening) {
+            mController.refresh();
+        }
+    }
+
+    @Override
+    protected void handleClick() {
+        LeoHifiState state = mController.getState();
+        if (state == null || !state.available || !state.supported || state.pending || !state.isFresh(SystemClock.elapsedRealtime())) {
+            return;
+        }
+        Dependency.get(ActivityStarter.class).postQSRunnableDismissingKeyguard(() -> {
+            LeoHifiState freshState = mController.getState();
+            if (freshState != null && freshState.available && freshState.supported && !freshState.pending && freshState.isFresh(SystemClock.elapsedRealtime())) {
+                mController.requestEnabled(!freshState.requested);
+            }
+        });
+    }
+
+    @Override
+    protected void handleLongClick() {
+        Dependency.get(ActivityStarter.class).postQSRunnableDismissingKeyguard(() -> {
+            LeoHifiState current = mController.getState();
+            if (current.available && current.supported && !current.pending
+                    && current.isFresh(SystemClock.elapsedRealtime()))
+                new LeoHifiVolumeDialog(mContext, mController).show();
+        });
+    }
+
+    @Override
+    public Intent getLongClickIntent() {
+        return null;
+    }
+
+    @Override
+    public boolean isAvailable() {
+        return "leo".equals(Build.DEVICE);
+    }
+
+    @Override
+    protected void handleUpdateState(BooleanState state, Object arg) {
+        LeoHifiState hifiState = (arg instanceof LeoHifiState) ? (LeoHifiState) arg : mController.getState();
+        long now = SystemClock.elapsedRealtime();
+
+        state.label = mContext.getString(R.string.leo_hifi_label);
+        state.icon = mIcon;
+
+        state.expandedAccessibilityClassName = Switch.class.getName();
+        state.contentDescription = state.label;
+        if (hifiState == null || !hifiState.available || !hifiState.supported) {
+            state.state = Tile.STATE_UNAVAILABLE;
+            state.value = false;
+            state.secondaryLabel = mContext.getString(R.string.leo_hifi_unavailable);
+            return;
+        }
+
+        boolean fresh = hifiState.isFresh(now);
+        state.value = hifiState.requested;
+
+        if (hifiState.pending || !fresh) {
+            state.state = Tile.STATE_UNAVAILABLE;
+            state.secondaryLabel = mContext.getString(R.string.leo_hifi_waiting);
+        } else if ("hal_error".equals(hifiState.reason) || "request_failed".equals(hifiState.reason)
+                || "request_rejected".equals(hifiState.reason)
+                || "hifi_degraded".equals(hifiState.effective) || "error_fallback".equals(hifiState.effective)) {
+            state.state = hifiState.requested ? Tile.STATE_ACTIVE : Tile.STATE_INACTIVE;
+            state.secondaryLabel = mContext.getString(R.string.leo_hifi_error);
+        } else if (hifiState.active) {
+            state.state = hifiState.requested ? Tile.STATE_ACTIVE : Tile.STATE_INACTIVE;
+            state.secondaryLabel = mContext.getString(R.string.leo_hifi_active);
+        } else {
+            state.state = hifiState.requested ? Tile.STATE_ACTIVE : Tile.STATE_INACTIVE;
+            state.secondaryLabel = mContext.getString(hifiState.requested
+                    ? R.string.leo_hifi_standby : R.string.leo_hifi_off);
+        }
+        state.contentDescription = state.label + ", " + state.secondaryLabel;
+    }
+
+    @Override
+    public CharSequence getTileLabel() {
+        return mContext.getString(R.string.leo_hifi_label);
+    }
+
+    @Override
+    public int getMetricsCategory() {
+        return MetricsEvent.VIEW_UNKNOWN;
+    }
+
+    @Override
+    public void onStateChanged(LeoHifiState state) {
+        refreshState(state);
+    }
+}
