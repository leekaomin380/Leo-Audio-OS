+package com.android.systemui.leo;
+
+import android.content.Context;
+import android.os.SystemClock;
+import com.android.systemui.Dependency;
+import com.android.systemui.R;
+import com.android.systemui.statusbar.phone.StatusBarIconController;
+
+public class LeoHifiStatusIcon implements LeoHifiController.Callback {
+    private static final String SLOT = "leo_hifi";
+    private static LeoHifiStatusIcon sInstance;
+
+    private final Context mContext;
+    private final StatusBarIconController mIconController;
+    private final LeoHifiController mHifiController;
+
+    private LeoHifiStatusIcon(Context context) {
+        mContext = context.getApplicationContext();
+        mIconController = Dependency.get(StatusBarIconController.class);
+        mHifiController = LeoHifiController.get(mContext);
+
+        mIconController.setIcon(SLOT, R.drawable.ic_leo_hifi, mContext.getString(R.string.leo_hifi_label));
+        mIconController.setIconVisibility(SLOT, false);
+
+        mHifiController.addCallback(this);
+        onStateChanged(mHifiController.getState());
+    }
+
+    public static synchronized void start(Context context) {
+        if (sInstance == null && "leo".equals(android.os.Build.DEVICE)) {
+            sInstance = new LeoHifiStatusIcon(context);
+        }
+    }
+
+    @Override
+    public void onStateChanged(LeoHifiState state) {
+        boolean visible = state != null && state.active && state.isFresh(SystemClock.elapsedRealtime());
+        mIconController.setIconVisibility(SLOT, visible);
+    }
+}
