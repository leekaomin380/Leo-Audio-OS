@@ -3524,6 +3539,34 @@
 
 #ifdef LEO_HIFI_ENABLED
 /*
+ * Leo: state-machine entry point, called from enable_audio_route() after the
+ * mixer path has been applied.  Runs the full read-back sequence, including
+ * the WCD bypass observation, and decides HIFI_ACTIVE / HIFI_DEGRADED /
+ * ERROR_FALLBACK.  Never advances on stale evidence: each call starts a new
+ * generation and re-reads everything.
+ */
+void platform_leo_hifi_route_enabled(void *platform, int snd_device)
+{
+    struct platform_data *my_data = (struct platform_data *)platform;
+
+    if (my_data == NULL)
+        return;
+
+    leo_hifi_on_route(&my_data->leo,
+                      snd_device == SND_DEVICE_OUT_LEO_HIFI_HEADPHONES);
+}
+
+void platform_leo_hifi_route_disabled(void *platform, int snd_device)
+{
+    struct platform_data *my_data = (struct platform_data *)platform;
+
+    if (my_data == NULL || snd_device != SND_DEVICE_OUT_LEO_HIFI_HEADPHONES)
+        return;
+
+    leo_hifi_on_route_off(&my_data->leo);
+}
